{
  "title": "Pantheon – Wartung",
  "uid": "pantheon-wartung",
  "tags": [
    "pantheon",
    "wartung"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15m",
  "time": {
    "from": "now-30d",
    "to": "now"
  },
  "editable": true,
  "description": "Stand der Wartung: Versionen, Sicherungen, Zustellung, Snapshots, Termine (rezept-monitoring-pantheon.md, Teil G).",
  "links": [
    {
      "title": "Pantheon – Vorgänge",
      "type": "link",
      "url": "/d/pantheon-vorgaenge",
      "icon": "dashboard"
    }
  ],
  "panels": [
    {
      "id": 1,
      "type": "table",
      "title": "Versionen — Ist, Ziel (Zwei-Wochen-Regel), neueste",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 10
      },
      "datasource": {
        "type": "prometheus",
        "uid": "pantheon-prom"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "pantheon_version_info",
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "job": true,
              "instance": true,
              "monitor": true,
              "Value": true
            },
            "renameByName": {
              "komponente": "Komponente",
              "ist": "Ist",
              "ziel": "Ziel",
              "ziel_datum": "Ziel vom",
              "neueste": "Neueste",
              "status": "Status",
              "regel": "Regel",
              "minor_rueckstand": "Minor-Rückstand"
            },
            "indexByName": {
              "komponente": 0,
              "ist": 1,
              "ziel": 2,
              "ziel_datum": 3,
              "neueste": 4,
              "status": 5,
              "minor_rueckstand": 6,
              "regel": 7
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Status"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "aktuell": {
                        "text": "aktuell",
                        "color": "green",
                        "index": 0
                      },
                      "faellig": {
                        "text": "fällig",
                        "color": "orange",
                        "index": 1
                      },
                      "wartet": {
                        "text": "wartet (Ziel < 14 Tage)",
                        "color": "blue",
                        "index": 2
                      },
                      "unbekannt": {
                        "text": "unbekannt",
                        "color": "red",
                        "index": 3
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "description": "Quelle: Wartungs-Sammler CT 113 (GitHub-Releases, omnictl, kubectl). Ziel = neuester mindestens 14 Tage alter Patch der nächsten Minor (Regel minor) bzw. der aktuellen Minor (Regel patch)."
    },
    {
      "id": 2,
      "type": "stat",
      "title": "etcd-Backup – Alter",
      "gridPos": {
