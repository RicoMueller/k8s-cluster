    {
      "id": 12,
      "type": "table",
      "title": "Cilium: Soll (Git) / Ist (Cluster)",
      "gridPos": {
        "x": 12,
        "y": 10,
        "w": 12,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "pantheon-prom"
      },
      "targets": [
        {
          "refId": "Git",
          "instant": true,
          "format": "table",
          "expr": "pantheon_git_image_info"
        },
        {
          "refId": "Cluster",
          "instant": true,
          "format": "table",
          "expr": "count by (image_spec) (kube_pod_container_info{cluster=\"pantheon\", namespace=\"kube-system\", container=~\"cilium-agent|cilium-operator|cilium-envoy\"})"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Value": true,
              "Value #Git": true,
              "file": true,
              "job": true,
              "instance": true,
              "monitor": true
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    }
