    {
      "id": 9,
      "type": "table",
      "title": "Aktive Alerts",
      "gridPos": {
        "x": 0,
        "y": 15,
        "w": 24,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "pantheon-prom"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "ALERTS{alertstate=\"firing\"}",
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Value": true,
              "__name__": true
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 10,
      "type": "stat",
      "title": "Omni-Manifest-Drift (Git ≠ Cluster)",
      "gridPos": {
        "x": 0,
        "y": 10,
        "w": 6,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "pantheon-prom"
      },
      "targets": [
        {
          "refId": "A",
          "instant": true,
          "expr": "count(pantheon_git_image_info unless on (image, tag) label_replace(label_replace(count by (image_spec) (kube_pod_container_info{cluster=\"pantheon\", namespace=\"kube-system\", container=~\"cilium-agent|cilium-operator|cilium-envoy\"}), \"image\", \"$1\", \"image_spec\", \"^([^:@]+):.*\"), \"tag\", \"$1\", \"image_spec\", \"^[^:@]+:([^@]+).*\")) or vector(0)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "orientation": "auto"
      }
    },
